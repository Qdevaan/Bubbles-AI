# Bubbles Brain API v5 — environment template
# Copy to .env and fill in. NEVER commit .env.

# Runtime
APP_ENV=development                  # development | staging | production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Auth + DB (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWKS_URL=
DATABASE_URL=                        # postgres://...:6543/postgres?pgbouncer=true

# Cache + jobs
REDIS_URL=redis://localhost:6379/0

# AI providers
GEMINI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Voice
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOGTAIL_SOURCE_TOKEN=

# Push
FIREBASE_CREDENTIALS_JSON=

# Dev only — MUST be unset in production
DEBUG_SKIP_AUTH=
